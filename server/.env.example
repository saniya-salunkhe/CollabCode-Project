# ─── CollabCode Server Environment ───
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/collabcode

# JWT secrets and lifetimes
JWT_SECRET=collabcode_super_secret_change_in_production
JWT_EXPIRES_IN=7d

# Judge0 configuration
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
# Alternatively use a self-hosted Judge0:
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Judge0 language IDs
LANG_JAVA=62
LANG_C=50
LANG_CPP=54
LANG_PYTHON=71
LANG_JAVASCRIPT=63
